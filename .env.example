DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/dbname"
REDIS_URL="redis://localhost:6379/0"
JWT_SECRET="dev_secret_key"
ADMIN_API_KEY="dev_admin_key"
USER_JWT_AUDIENCE="user-api"
MIN_PASSWORD_LENGTH="8"
JWT_ISSUER="chatbot-platform"
JWT_AUDIENCE="widget-api"
WIDGET_TOKEN_EXPIRE_SECONDS="86400"
ENVIRONMENT="development"
SERVICE_NAME="api"
GIT_SHA="dev"
OTEL_ENABLED="true"
OTEL_SAMPLE_RATE="0.01"
LOG_LEVEL="INFO"

AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_API_KEY="your-azure-key"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"
AZURE_DEPLOYMENT_NAME="gpt-4.1"

AZURE_EMBEDDING_API_KEY="your-embedding-key"
AZURE_EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-small"
AZURE_EMBEDDING_ENDPOINT="https://your-embedding-resource.openai.azure.com/"
AZURE_EMBEDDING_API_VERSION="2024-02-15-preview"

S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_BUCKET="rag-chatbot"
S3_PUBLIC_URL="https://<bucket>.r2.dev"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_SSE="AES256"
RATE_LIMIT_REQUESTS_PER_MINUTE="60"
RATE_LIMIT_TOKENS_PER_MINUTE="100000"
RATE_LIMIT_IP_PER_MINUTE="1000"
RATE_LIMIT_INGEST_PER_MINUTE="10"
RATE_LIMIT_CHAT_PER_MINUTE="30"
RATE_LIMIT_TOKEN_REFRESH_PER_MINUTE="1000"
MAX_FILE_SIZE_MB="50"
MAX_PDF_PAGES="1000"
URL_FETCH_TIMEOUT_SECONDS="30"
URL_FETCH_MAX_REDIRECTS="5"
