{
  "name": "contextly",
  "version": "0.0.1",
  "description": "A lightweight, flexible contextly widget for adding RAG-powered chat to your application.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run generate:css && pnpm run build:js",
    "generate:css": "tailwindcss -i ./src/style.css -o ./src/generated.css",
    "build:js": "tsup src/index.ts --format cjs,esm --dts --clean --inject-style",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "lucide-react": "^0.330.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.2.1"
  }
}
